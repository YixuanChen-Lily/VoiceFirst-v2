OPENAI_API_KEY=sk-your-openai-key
ELEVENLABS_API_KEY=elevenlabs-your-key
# Knowledge base (Supabase): original files go to Storage, records and embeddings to Postgres.
# Use the secret key, not the publishable one, and the "Session pooler" connection string.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-secret-key
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres
# Sign-in (Supabase Auth). The publishable key is public and is used by the website.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Comma-separated emails allowed to add and remove library documents.
LIBRARY_ADMIN_EMAILS=you@example.com
# Local development only: set to true to use the API without signing in.
AUTH_DISABLED=
# Jev scores each chat turn so it can be routed to the right chat model.
# Leave empty to turn routing off; every turn then uses OPENAI_CHAT_MODEL.
TYPESAFE_API_KEY=your-typesafe-key
NEXT_PUBLIC_DEFAULT_API_BASE_URL=http://127.0.0.1:8000/api
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
# Optional overrides
# Models. Change these to switch models.
# Chat turns that only supply facts go to OPENAI_CHAT_MODEL; turns that ask for
# writing or advice go to OPENAI_COMPLEX_CHAT_MODEL. Draft scoring uses
# OPENAI_ANALYSIS_MODEL.
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_COMPLEX_CHAT_MODEL=gpt-6.1-sol
OPENAI_ANALYSIS_MODEL=gpt-6.1-sol
# A voice ID from your ElevenLabs account, not a voice name (this one is "Sarah")
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_BASE_URL=https://api.elevenlabs.io/v1/text-to-speech
ELEVENLABS_STT_ENDPOINT=https://api.elevenlabs.io/v1/speech-to-text
# Chat router
TYPESAFE_ROUTER_MODEL=jev-1.13.0
CHAT_ROUTER_THRESHOLD=0.5
# Knowledge base tuning. Changing the chunk settings or the embedding model
# requires re-indexing existing documents.
SUPABASE_BUCKET=documents
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Chat retrieval: library passages considered per chat turn, and the maximum
# distance (0 = identical meaning) for a passage to be used.
CHAT_RETRIEVAL_K=4
CHAT_RETRIEVAL_MAX_DISTANCE=0.5
